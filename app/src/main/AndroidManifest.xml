<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App_1">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App_1"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".StudentActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".OfficeActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Student flow -->
        <activity
            android:name=".ReportLostActivity"
            android:exported="false" />
        <activity
            android:name=".ReportFoundActivity"
            android:exported="false" />
        <activity
            android:name=".CategoryDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".CandidateDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ClaimStatusActivity"
            android:exported="false" />

        <!-- Office flow -->
        <activity
            android:name=".FoundItemCheckInActivity"
            android:exported="false" />
        <activity
            android:name=".SensitiveItemCheckInActivity"
            android:exported="false" />
        <activity
            android:name=".OwnershipVerificationActivity"
            android:exported="false" />
        <activity
            android:name=".PickupHandoverActivity"
            android:exported="false" />
        <activity
            android:name=".UnclaimedItemsActivity"
            android:exported="false" />
        <activity
            android:name=".CategoryRulesActivity"
            android:exported="false" />
        <activity
            android:name=".AccessAuditActivity"
            android:exported="false" />

    </application>

</manifest>